# IMOL: auto-activate the project's Python virtualenv when entering this folder.
# Usage (once per machine):
#   1) Install direnv
#   2) Add the direnv hook to your shell (zsh)
#   3) In this repo root: direnv allow
#
# This file is intentionally small + portable. It prefers the root venv, but
# falls back to the per-subproject venv if needed.

if [ -f "./imol-venv/bin/activate" ]; then
  # Preferred venv for this repo
  source "./imol-venv/bin/activate"
elif [ -f "./python-light-engine/imol-venv/bin/activate" ]; then
  # Fallback (older layout)
  source "./python-light-engine/imol-venv/bin/activate"
fi

# Make `import ...` work when running tools from the repo root.
export PYTHONPATH="$PWD/python-light-engine:${PYTHONPATH:-}"

